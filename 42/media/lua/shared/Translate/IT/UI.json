    "UI_MSM_Help_Locations_01": "DOVE SI TROVA IL MOD",
    "UI_MSM_Help_Locations_02": "Steam/steamapps/workshop/content/108600/",
    "UI_MSM_Help_Locations_03": "3721602150/mods/ManualSaveMod/",
    "UI_MSM_Help_Locations_04": "In cima: Watcher.cmd, Watcher.ps1, mod.info.",
