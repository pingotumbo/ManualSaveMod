    "UI_MSM_Help_Start_01": "Manual Save Mod  v1.0.1",
    "UI_MSM_Help_Start_02": "COSA OTTIENI",
    "UI_MSM_Help_Start_03": "Piu' slot di salvataggio con nome per ogni mondo.",
    "UI_MSM_Help_Start_04": "Quick Save - checkpoint istantaneo in gioco.",
    "UI_MSM_Help_Start_05": "Full Save - esci al menu, scrivi tutto su disco, ricarica.",
    "UI_MSM_Help_Start_06": "Rinomina, duplica, elimina e importa salvataggi vanilla.",
    "UI_MSM_Help_Start_07": "Miniatura automatica per ogni salvataggio.",
    "UI_MSM_Help_Start_08": "REQUISITI",
    "UI_MSM_Help_Start_09": "Windows 10 o 11",
    "UI_MSM_Help_Start_10": "Il Watcher usa cmd.exe, robocopy, PowerShell,",
    "UI_MSM_Help_Start_11": "e user32.dll - tutti componenti Windows standard.",
    "UI_MSM_Help_Start_12": "Solo Build 42",
    "UI_MSM_Help_Start_13": "Le API Lua su B41 differiscono; il mod non si carichera'",
    "UI_MSM_Help_Start_14": "correttamente su quella versione.",
    "UI_MSM_Help_Start_15": "CONFIGURAZIONE - PASSO PER PASSO",
    "UI_MSM_Help_Start_16": "1. Iscriviti su Steam e lascia che si installi",
    "UI_MSM_Help_Start_17": "Cartella mod: Steam/steamapps/workshop/content/",
    "UI_MSM_Help_Start_18": "108600/3721602150/mods/ManualSaveMod/",
    "UI_MSM_Help_Start_19": "2. Abilita il mod nel tuo salvataggio",
    "UI_MSM_Help_Start_20": "Menu principale > Mod > Manual Save Mod [B42] > abilita.",
    "UI_MSM_Help_Start_21": "Per un mondo esistente: abilita anche dalla lista",
    "UI_MSM_Help_Start_22": "mod del mondo prima di caricare.",
    "UI_MSM_Help_Start_23": "3. Trova ManualSave_Watcher.cmd",
    "UI_MSM_Help_Start_24": "ManualSave_Watcher.cmd   (script di avvio)",
    "UI_MSM_Help_Start_25": "ManualSave_Watcher.ps1   (logica watcher)",
    "UI_MSM_Help_Start_26": "4. Avvia il Watcher",
    "UI_MSM_Help_Start_27": "Doppio clic su ManualSave_Watcher.cmd.",
    "UI_MSM_Help_Start_28": "Si apre una finestra PowerShell - lasciala aperta.",
    "UI_MSM_Help_Start_29": "Lasciala in esecuzione in background, poi avvia PZ.",
    "UI_MSM_Help_Start_30": "Aggiungi un collegamento sul desktop per comodita'.",
    "UI_MSM_Help_Start_31": "5. Verifica che comunichi col gioco",
    "UI_MSM_Help_Start_32": "In gioco: ESC > Salva. Tutti i pulsanti devono essere attivi",
    "UI_MSM_Help_Start_33": "e il punto in alto mostra 'Watcher in esecuzione'.",
    "UI_MSM_Help_Start_34": "Punto rosso = .cmd non e' in esecuzione. Riaprilo.",
    "UI_MSM_Help_Start_35": "DA QUI",
    "UI_MSM_Help_Start_36": "Salva > Quick Save  - checkpoint veloce in gioco.",
    "UI_MSM_Help_Start_37": "Salva > Full Save   - salvataggio affidabile a fine sessione.",
    "UI_MSM_Help_Start_38": "Carica              - gestisci e ripristina salvataggi.",
    "UI_MSM_Help_Start_39": "Riferimento > Glossario - termini spiegati.",
    "UI_MSM_Help_Start_40": "Risoluzione problemi - se qualcosa non funziona.",
    "UI_MSM_Help_Safety_01": "RISPOSTA BREVE",
    "UI_MSM_Help_Safety_02": "Si'. Il mod include script .ps1 e .cmd aperti,",
    "UI_MSM_Help_Safety_03": "entrambi testo semplice, leggibili nel Blocco Note.",
    "UI_MSM_Help_Safety_04": "Nessuna parte del mod accede alla rete.",
    "UI_MSM_Help_Safety_05": "Nessuna parte modifica l'eseguibile di PZ.",
    "UI_MSM_Help_Safety_06": "La disinstallazione ripristina i salvataggi allo stato vanilla.",
    "UI_MSM_Help_Safety_07": "COSA FA DAVVERO IL WATCHER",
    "UI_MSM_Help_Safety_08": "In un loop da 500ms fa quattro cose:",
    "UI_MSM_Help_Safety_09": "1. Legge piccoli file .txt di segnale da Zomboid/Lua/.",
    "UI_MSM_Help_Safety_10": "2. Copia, sposta o elimina cartelle in Zomboid/",
    "UI_MSM_Help_Safety_11": "   usando robocopy.",
    "UI_MSM_Help_Safety_12": "3. Esegue PowerShell per catturare la finestra di gioco.",
    "UI_MSM_Help_Safety_13": "4. Scrive il file Done in modo che il gioco veda il risultato.",
    "UI_MSM_Help_Safety_14": "Nessuna modifica al registro.",
    "UI_MSM_Help_Safety_15": "Nessuna chiamata di rete esterna.",
    "UI_MSM_Help_Safety_16": "Nessun servizio in background o avvio automatico.",
    "UI_MSM_Help_Safety_17": "COME VERIFICARLO TU STESSO",
    "UI_MSM_Help_Safety_18": "Apri ManualSave_Watcher.ps1 nel Blocco Note.",
    "UI_MSM_Help_Safety_19": "Task Manager > Dettagli: Watcher = powershell.exe",
    "UI_MSM_Help_Safety_20": "  con ManualSave_Watcher.ps1 nella riga di comando.",
    "UI_MSM_Help_Safety_21": "Monitor risorse > Rete: nessun socket aperto.",
    "UI_MSM_Help_Safety_22": "PERCHE' L'ANTIVIRUS PUO' SEGNALARLO",
    "UI_MSM_Help_Safety_23": "Alcuni antivirus segnalano qualsiasi .ps1 non firmato",
    "UI_MSM_Help_Safety_24": "che chiama robocopy - un'euristica, non una vera",
    "UI_MSM_Help_Safety_25": "rilevazione di comportamento dannoso.",
    "UI_MSM_Help_Safety_26": "Leggi prima il file, poi decidi.",
    "UI_MSM_Help_Safety_27": "Se non ti fidi: non eseguirlo.",
    "UI_MSM_Help_Safety_28": "Il lato Lua rimane disabilitato; PZ si comporta come vanilla.",
    "UI_MSM_Help_Safety_29": "Entrambi i file sono identici byte per byte su tutti gli",
    "UI_MSM_Help_Safety_30": "install Steam Workshop della stessa versione del mod.",
    "UI_MSM_Help_Watcher_01": "PERCHE' ESISTE IL WATCHER",
    "UI_MSM_Help_Watcher_02": "PZ esegue Lua tramite Kahlua, un interprete ridotto.",
    "UI_MSM_Help_Watcher_03": "Kahlua nasconde quasi tutta la libreria os.*:",
    "UI_MSM_Help_Watcher_04": "nessun os.execute, os.rename, os.remove, no mkdir.",
    "UI_MSM_Help_Watcher_05": "Un salvataggio manuale e' una copia di cartella. Lua dentro PZ",
    "UI_MSM_Help_Watcher_06": "non puo' farlo. Il Watcher e' la soluzione",
    "UI_MSM_Help_Watcher_07": "piu' leggera: un processo Windows esterno.",
    "UI_MSM_Help_Watcher_08": "COSA FA",
    "UI_MSM_Help_Watcher_09": "SAVE        Copia il mondo attivo in uno slot nominato.",
    "UI_MSM_Help_Watcher_10": "LOAD        Copia uno slot nel mondo attivo.",
    "UI_MSM_Help_Watcher_11": "DELETE      Rimuove ricorsivamente una cartella slot.",
    "UI_MSM_Help_Watcher_12": "RENAME      Rinomina una cartella slot.",
    "UI_MSM_Help_Watcher_13": "CLONE       Copia uno slot con un nuovo nome.",
    "UI_MSM_Help_Watcher_14": "RENAME_WORLD   Rinomina la cartella del mondo.",
    "UI_MSM_Help_Watcher_15": "STRIP_MODS     Svuota mods.txt in uno slot.",
    "UI_MSM_Help_Watcher_16": "SCAN_VANILLA   Elenca i salvataggi vanilla esistenti.",
    "UI_MSM_Help_Watcher_17": "IMPORT      Copia salvataggi vanilla in ManualSave.",
    "UI_MSM_Help_Watcher_18": "SCREENSHOT     Cattura la finestra PZ come miniatura.",
    "UI_MSM_Help_Watcher_19": "COME COMUNICA COL GIOCO",
    "UI_MSM_Help_Watcher_20": "Il Watcher controlla %USERPROFILE%\\\\Zomboid\\\\Lua\\\\",
    "UI_MSM_Help_Watcher_21": "per ManualSave_Signal.txt scritto dal lato Lua.",
    "UI_MSM_Help_Watcher_22": "Analizza l'operazione > la esegue > scrive Done.txt.",
    "UI_MSM_Help_Watcher_23": "Un contatore heartbeat si incrementa ogni ciclo",
    "UI_MSM_Help_Watcher_24": "cosi' il gioco puo' rilevare se il Watcher si chiude.",
    "UI_MSM_Help_Watcher_25": "Nessuna installazione, nessun servizio, nessun avvio automatico.",
    "UI_MSM_Help_Watcher_26": "Se non avvii il .cmd il mod e' inattivo.",
    "UI_MSM_Help_Watcher_27": "Questo rende l'installazione facilmente reversibile.",
    "UI_MSM_Help_WatcherRun_01": "AVVIARLO MANUALMENTE",
    "UI_MSM_Help_WatcherRun_02": "Doppio clic su ManualSave_Watcher.cmd.",
    "UI_MSM_Help_WatcherRun_03": "Si apre una finestra PowerShell - lasciala aperta.",
    "UI_MSM_Help_WatcherRun_04": "Il Watcher e' ora in esecuzione in background.",
    "UI_MSM_Help_WatcherRun_05": "DOVE SI TROVA IL FILE",
    "UI_MSM_Help_WatcherRun_06": "Steam\\\\steamapps\\\\workshop\\\\content\\\\108600\\\\",
    "UI_MSM_Help_WatcherRun_07": "3721602150\\\\mods\\\\ManualSaveMod\\\\",
    "UI_MSM_Help_WatcherRun_08": "ManualSave_Watcher.cmd   (avviatore)",
    "UI_MSM_Help_WatcherRun_09": "ManualSave_Watcher.ps1   (logica watcher)",
    "UI_MSM_Help_WatcherRun_10": "Puoi trovarlo anche dalla schermata Mod di PZ:",
    "UI_MSM_Help_WatcherRun_11": "Mod > Manual Save Mod > Apri Cartella.",
    "UI_MSM_Help_WatcherRun_12": "COLLEGAMENTO SUL DESKTOP",
    "UI_MSM_Help_WatcherRun_13": "Clic destro su ManualSave_Watcher.cmd > Invia a >",
    "UI_MSM_Help_WatcherRun_14": "Desktop (crea collegamento).",
    "UI_MSM_Help_WatcherRun_15": "AVVIALO CON IL GIOCO (CONSIGLIATO)",
    "UI_MSM_Help_WatcherRun_16": "Crea un launcher.bat con queste righe:",
    "UI_MSM_Help_WatcherRun_17": "  @echo off",
    "UI_MSM_Help_WatcherRun_18": "  start /min ManualSave_Watcher.cmd",
    "UI_MSM_Help_WatcherRun_19": "  start steam://run/108600",
    "UI_MSM_Help_WatcherRun_20": "Doppio clic su quel launcher invece di PZ direttamente.",
    "UI_MSM_Help_WatcherRun_21": "Il Watcher si avvia prima, poi il gioco.",
    "UI_MSM_Help_WatcherRun_22": "AVVIO ALL'ACCESSO (OPZIONALE)",
    "UI_MSM_Help_WatcherRun_23": "Win+R > digita shell:startup > Invio.",
    "UI_MSM_Help_WatcherRun_24": "Trascina li' un collegamento a ManualSave_Watcher.cmd.",
    "UI_MSM_Help_WatcherRun_25": "Il Watcher ora si avvia ad ogni accesso.",
    "UI_MSM_Help_WatcherRun_26": "Utile solo se giochi spesso a PZ.",
    "UI_MSM_Help_WatcherRun_27": "COME FERMARLO",
    "UI_MSM_Help_WatcherRun_28": "Task Manager > Dettagli > trova cmd.exe con",
    "UI_MSM_Help_WatcherRun_29": "ManualSave_Watcher nel comando > Termina attivita'.",
    "UI_MSM_Help_WatcherRun_30": "Il Watcher cancella il file lock alla chiusura normale.",
    "UI_MSM_Help_WatcherRun_31": "Se si blocca il lock potrebbe rimanere.",
    "UI_MSM_Help_WatcherRun_32": "Vedi Risoluzione problemi > Watcher non si avvia.",
    "UI_MSM_Help_Quicksave_01": "COS'E'",
    "UI_MSM_Help_Quicksave_02": "Una copia istantanea della cartella di salvataggio attiva",
    "UI_MSM_Help_Quicksave_03": "senza uscire dal gioco. Il mondo continua a girare",
    "UI_MSM_Help_Quicksave_04": "mentre la copia avviene in background.",
